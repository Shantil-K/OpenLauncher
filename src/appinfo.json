{
  "id": "com.homebrew.openlauncher",
  "version": "2.0.0",
  "vendor": "Shantil-K",
  "spinnerOnLaunch":false,
  "type": "web",
  "main": "index.html",
  "requiredPermissions": ["all"],
  "appCategory": ["home"],
"resolution": [
                "3840x2160",
                "1920x1080",
                "1280x720",
		"854×480"
        ],

        "supportTouchMode": "full",
	  "disableBackHistoryAPI": true,
        "supportPortraitMode": true,
  "title": "OpenLauncher",
  "icon": "icon.png",
  "largeIcon": "largeIcon.png",
  "noSplashOnLaunch": true,
  "supportGIP": true
}
